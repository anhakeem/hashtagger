# .env.example — copy to .env and fill in. NEVER commit .env.
# AI provider (OpenAI-compatible; works with any provider)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional: X/Twitter API (for trend data)
X_BEARER_TOKEN=

# App
APP_SECRET_KEY=
DATABASE_URL=sqlite:///./hashtagger.db
LOG_LEVEL=INFO
