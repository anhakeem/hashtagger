# .env.example — copy to .env and fill in. NEVER commit .env.
#
# AI provider — OpenAI-compatible. The engine reads these three vars.
#
# RECOMMENDED (no API key, no per-use charge): run `hermes proxy start`
# and point at the local proxy, which rides your existing Nous Portal login.
#   OPENAI_BASE_URL=http://127.0.0.1:8645/v1
#   OPENAI_API_KEY=placeholder
#   OPENAI_MODEL=inclusionai/ling-3.1-flash
#
# Or any OpenAI-compatible provider you have a key for (OpenAI, OpenRouter,
# Groq, Together, a local llama.cpp/ollama server, …).
OPENAI_API_KEY=placeholder
OPENAI_BASE_URL=http://127.0.0.1:8645/v1
OPENAI_MODEL=inclusionai/ling-3.1-flash

# Trend data providers.
# MVP ships FREE sources: Mastodon + Reddit (no key needed).
# Production X/Twitter source (optional): TwitterAPI.io — set the key to enable
# it. $0.15/1K tweets, no monthly fee. https://twitterapi.io
TWITTERAPI_IO_KEY=

# App
APP_SECRET_KEY=
DATABASE_URL=sqlite:///./hashtagger.db
LOG_LEVEL=INFO
