{
  "manifest_version": 3,
  "name": "Hashtagger",
  "version": "1.0.0",
  "description": "Get ranked, trending hashtags for your post — right in the composer.",
  "browser_specific_settings": {
    "gecko": {
      "id": "hashtagger@anhakeem.dev",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hashtagger"
  },
  "background": {
    "scripts": ["browser-compat.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["browser-compat.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://localhost:8000/*"],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
